# Copy to .env and fill in. Never commit real secrets.
PORT=5000
# Your MongoDB Atlas link, e.g. mongodb+srv://<user>:<pass>@cluster0.xxxx.mongodb.net/sebc
MONGODB_URI=
JWT_SECRET=change-this-to-a-long-random-value
JWT_EXPIRES_IN=8h
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=choose-a-strong-password
# Allowed browser origins (CORS), comma-separated. Browsers block everything else.
# Local dev needs: http://localhost:5173
# After deploying the frontend to Vercel, append its URL too, e.g.:
# FRONTEND_URL=http://localhost:5173,https://sebc-frontend.vercel.app
# Then set this SAME value in the Vercel dashboard (backend project >
# Settings > Environment Variables) and redeploy the backend.
FRONTEND_URL=http://localhost:5173
# Optional extra origins, merged with FRONTEND_URL above.
CORS_ORIGINS=
# Email sending: pick ONE channel.
# A) Resend HTTPS API (recommended for Render/Vercel — works over port 443
#    even where outbound SMTP is firewalled). Free at https://resend.com:
#    create an API key, verify your sending domain, then set:
#    - RESEND_API_KEY=re_...
#    - MAIL_FROM="SEBC Sandip E-Club <noreply@YOUR-VERIFIED-DOMAIN>"
#    For a quick test without a domain, MAIL_FROM may be onboarding@resend.dev
#    (delivers only to your own Resend account email).
RESEND_API_KEY=
# B) Gmail SMTP fallback (needs direct TCP egress to smtp.gmail.com:587 —
#    blocked on some Render hosts). Create an App Password at
#    Google Account > Security > 2-Step Verification > App passwords,
#    then paste it below (never commit real values).
#    The mailer pre-resolves Gmail to IPv4 to avoid ENETUNREACH on IPv6 routes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Alias accepted for the Gmail App Password (either SMTP_PASS or SMTP_APP_PASSWORD works).
SMTP_APP_PASSWORD=
MAIL_FROM=
# Public base URL of THIS backend (used for absolute links inside emails).
BACKEND_URL=http://localhost:5000
